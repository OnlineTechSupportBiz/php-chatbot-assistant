{
    "name": "onlinetechsupportbiz/php-chatbot-assistant",
    "description": "Multi-tenant chatbot SaaS platform — AI-powered conversations, lead capture, document RAG, and multi-user management.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Online Tech Support, LLC",
            "homepage": "https://OnlineTechSupport.biz"
        }
    ],
    "homepage": "https://github.com/OnlineTechSupportBiz/php-chatbot-assistant",
    "support": {
        "issues": "https://github.com/OnlineTechSupportBiz/php-chatbot-assistant/issues",
        "source": "https://github.com/OnlineTechSupportBiz/php-chatbot-assistant"
    },
    "keywords": [
        "chatbot",
        "saas",
        "multi-tenant",
        "ai",
        "conversational-ai",
        "lead-generation",
        "rag",
        "pageindex",
        "php"
    ],
    "require": {
        "php": ">=8.2",
        "phpmailer/phpmailer": "^7.1",
        "spomky-labs/otphp": "^11.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/"
        }
    },
    "scripts": {
        "migrate": "php migrations/run.php",
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t public_html"
    },
    "config": {
        "optimize-autoloader": true
    }
}
