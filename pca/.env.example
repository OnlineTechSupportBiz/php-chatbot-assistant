# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SCHEMA=chatbot_schema
DB_NAME=chatbot_assistant
DB_USER=chatbot_user
DB_PASS=
# Optional two-role Row-Level Security model (recommended). The migrator role
# OWNS the tables so the app role stays subject to RLS; leaving these empty
# keeps the app role as owner (app-layer-only tenant isolation).
# DB_MIGRATOR_USER=chatbot_migrator
# DB_MIGRATOR_PASS=
# ALLOW_SINGLE_ROLE_DB=true

# App
APP_ENV=production
APP_URL=http://localhost:8000

# Session
SESSION_COOKIE_NAME=chatbot_session
# minutes (default 1440) — cookie lifetime. With Remember Me, extends to 30 days.
SESSION_LIFETIME=1440

# SMTP / Mail (PHPMailer — used for email verification and password reset)
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_AUTH=true
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Chatbot Assistant"
