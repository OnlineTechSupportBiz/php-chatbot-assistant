#
# Template for a fresh deployment. Copy to .env and fill in the blanks.
# The installer (public_html/install.php) writes the same keys for you.
#
# Every tenant-level setting (providers, keys, models, brand, timezone) is
# stored in the database and edited in Settings — this file is deployment-level
# only.
#
# Key vars hold no secrets here; generate real values:
#   DB passwords        openssl rand -hex 24
#

# ── Database ────────────────────────────────────────────────────────────────
# Two roles, and the split matters: DB_MIGRATOR_USER owns the tables, DB_USER
# only reads and writes them. PostgreSQL exempts a table's owner from its own
# RLS policies, so if one role did both, tenant isolation would be silently
# inert. Both must already exist before the installer runs.
DB_HOST=127.0.0.1
DB_PORT=5432
# Any schema name is allowed; migrations reference it directly.
DB_SCHEMA=chatbot_schema
DB_NAME=chatbot_assistant
# The application role: DML only, subject to Row-Level Security.
DB_USER=chatbot_user
DB_PASS=
# The owner role: runs the migrations. Required in production.
DB_MIGRATOR_USER=chatbot_migrator
DB_MIGRATOR_PASS=
# Escape hatch for the single-role DB model — no database-level tenant
# isolation. Only set true when DB_MIGRATOR_USER is empty.
ALLOW_SINGLE_ROLE_DB=false

# ── App ─────────────────────────────────────────────────────────────────────
# production | development. Controls HSTS and error handling.
APP_ENV=production
# Absolute base URL: drives email links and secure cookies.
APP_URL=https://chatbot.example.com

# ── Sessions ────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=chatbot_assistant_session
# Minutes (default 1440). With Remember Me, extends to 30 days.
SESSION_LIFETIME=1440

# ── Mail (PHPMailer — email verification, password reset, magic links) ─────
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_AUTH=true
SMTP_USER=
SMTP_PASS=
# ssl | tls | (empty for none)
SMTP_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Chatbot Assistant